{
	"name": "salvocortesiano/dbguardian",
	"type": "phpbb-extension",
	"description": "Sostituisce l'Errore Generale di phpBB con una pagina di servizio responsive e avvisa l'amministratore via e-mail quando il database non risponde.",
	"homepage": "https://netshadows.de/ombra/",
	"version": "1.0.4",
	"time": "2026-09-24",
	"keywords": [
		"phpbb",
		"extension",
		"database",
		"error page",
		"monitoring",
		"downtime"
	],
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Salvo Cortesiano",
			"email": "info@netshadows.de",
			"homepage": "https://netshadows.de",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=7.4.0",
		"composer/installers": "~1.0"
	},
	"extra": {
		"display-name": "DB Guardian",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
		}
	}
}
